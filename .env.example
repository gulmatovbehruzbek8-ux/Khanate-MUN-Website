# Google Sheets (registrations are appended as rows)
# 1. Create a Google Cloud service account, enable the Google Sheets API, download its JSON key.
# 2. Share your Google Sheet with the service account's email (Editor).
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private_key value from the JSON key. Keep the \n characters as-is, wrap in double quotes.
GOOGLE_PRIVATE_KEY=
# Name of the tab that receives registrations (default: Registrations)
GOOGLE_SHEET_TAB=Registrations

# Admin panel at /admin (required to use it). Pick a long password.
ADMIN_PASSWORD=
# Optional: separate secret used to sign the login cookie (defaults to the password).
ADMIN_SECRET=
# Testing only: store registrations in a local file even in production mode.
# USE_DEV_STORE=1

# Photo uploads on Vercel: create a Blob store in the Vercel dashboard and connect it; this variable is added automatically.
# BLOB_READ_WRITE_TOKEN=
